[sub_resource type="GDScript" id="GDScript_0cbny"]
script/source = "@tool
extends Brush
## Example of extending a Brush with your own behaviour.
##
## The point of the exercise: attaching a script to a node REPLACES whatever script was there,
## so a plain `extends MeshInstance3D` would throw the brush away. Extending Brush keeps all of
## it — and because every Duckboard tool tests `node is Brush`, a subclass stays fully editable
## with the vertex, face, clip and texture tools.


## Turned into a real brush property by @export, so it shows in the inspector alongside the
## brush's own snap size and lock toggles.
@export var spin_degrees_per_second := 45.0

@export var announce_on_ready := true


func _ready() -> void:
	# REQUIRED. Brush._ready() solves the planes, builds the mesh and captures the pose that
	# texture lock measures against. Without this call the node is an empty MeshInstance3D
	# wearing a brush's data — no error, just nothing on screen.
	super()
	if announce_on_ready and not Engine.is_editor_hint():
		print(\"Brush '%s' ready: %d faces, %d corners\"
			% [name, planes.size(), get_vertices().size()])


func _process(delta: float) -> void:
	# Editor-side guard: without it the brush would spin while you are trying to edit it, and
	# every frame would mark the scene dirty.
	if Engine.is_editor_hint():
		return
	rotate_y(deg_to_rad(spin_degrees_per_second) * delta)


## Brush overrides _notification for texture lock, so an override here MUST chain — otherwise
## the texture stops following the brush when the lock is on.
func _notification(what: int) -> void:
	super(what)
	if what == NOTIFICATION_TRANSFORM_CHANGED and not Engine.is_editor_hint():
		pass   # your own reaction to being moved goes here


## Everything the brush knows is available: `planes` is the source of truth, and the derived
## geometry is queryable without touching the mesh.
func describe() -> String:
	var bounds := get_aabb()
	return \"%s: %d planes, %d corners, %.2f x %.2f x %.2f m\" % [
		name, planes.size(), get_vertices().size(),
		bounds.size.x, bounds.size.y, bounds.size.z]
"

